{
  "name": "heroes3tools",
  "type": "module",
  "version": "2.9.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    }
  },
  "description": "Game tools for simplify calculations in Heroes of Might and Magic III: Horn of The Abyss",
  "license": "MIT",
  "homepage": "https://heroes3tools.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudnovd/heroes3tools.git"
  },
  "bugs": "https://github.com/rudnovd/heroes3tools/issues",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "vite",
    "build": "vue-tsc && vite build",
    "build:app": "vue-tsc && cross-env IS_TAURI_BUILD=true vite build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "cross-env NODE_ENV=production eslint .",
    "lint:fix": "cross-env NODE_ENV=production eslint --fix .",
    "stylelint": "stylelint '**/*{.scss,.vue}'",
    "stylelint:fix": "stylelint '**/*{.scss,.vue}' --fix",
    "prerelease": "pnpm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@unhead/vue": "^3.3.2",
    "@vueuse/core": "^14.4.0",
    "@vueuse/shared": "^14.4.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "24.13.2",
    "@unhead/addons": "^3.3.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "postcss-html": "^2.0.0",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-rem-over-px": "^2.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
