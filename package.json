{
  "name": "heroes3tools",
  "type": "module",
  "version": "2.12.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    }
  },
  "description": "Game tools for simplify calculations in Heroes of Might and Magic III: Horn of The Abyss",
  "license": "MIT",
  "homepage": "https://heroes3tools.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudnovd/heroes3tools.git"
  },
  "bugs": "https://github.com/rudnovd/heroes3tools/issues",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest",
    "lint:eslint": "eslint 'src/**/*'",
    "lint:eslint:fix": "eslint --fix 'src/**/*'",
    "lint:stylelint": "stylelint 'src/**/*{.css,.vue}'",
    "lint:stylelint:fix": "stylelint --fix 'src/**/*{.css,.vue}'",
    "updates:install": "pnpm update --interactive --latest",
    "run:prerender": "node scripts/prerender.mjs",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@unhead/vue": "^3.4.2",
    "@vueuse/core": "^15.0.0",
    "@vueuse/shared": "^15.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@iconify-json/mdi": "^1.2.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "24.13.2",
    "@unhead/addons": "^3.4.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "playwright": "^1.64.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-rem-over-px": "^2.0.1",
    "typescript": "6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
